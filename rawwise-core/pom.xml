    <build>
        <plugins>

            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
                <version>4.8.1</version>
                <executions>
                    <execution>
                        <id>scala-compile-first</id>
                        <phase>none</phase>
                        <goals>
                            <goal>add-source</goal>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>scala-test-compile</id>
                        <phase>none</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <scalaVersion>${scala.version}</scalaVersion>
                    <args>
                        <arg>-deprecation</arg>
                        <arg>-feature</arg>
                        <arg>-unchecked</arg>
                    </args>
                    <recompileMode>incremental</recompileMode>
                    <compileOrder>JavaThenScala</compileOrder>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <useIncrementalCompilation>false</useIncrementalCompilation>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.30</version>
                        </path>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>1.37</version>
                        </path>
                    </annotationProcessorPaths>
                    <testExcludes>
                        <testExclude>**/SparkIRAdaptorTest.java</testExclude>
                        <testExclude>**/CompactionIntegrationTest.java</testExclude>
                        <testExclude>**/CompactionManagerPlanTest.java</testExclude>
                        <testExclude>**/CompactionManagerRecoveryTest.java</testExclude>
                        <testExclude>**/SparkRecordConverterTest.java</testExclude>
                        <testExclude>**/ShardTxnRpcTest.java</testExclude>
                        <testExclude>**/DynamicMmapStoreWALIntegrationTest.java</testExclude>
                        <testExclude>**/GroupCommitE2ETest.java</testExclude>
                        <testExclude>io/github/rawwise/axiom/orchestrator/**</testExclude>
                        <testExclude>io/github/rawwise/axiom/memory/MemoryE2ETest.java</testExclude>
                        <testExclude>io/github/rawwise/axiom/memory/MemoryFacadeIntegrationTest.java</testExclude>
                        <testExclude>io/github/rawwise/axiom/pipeline/MultiAgentConcurrencyTest.java</testExclude>
                        <testExclude>io/github/rawwise/axiom/pipeline/cognition/**</testExclude>
                        <testExclude>io/github/rawwise/axiom/pipeline/evaluation/**</testExclude>
                        <testExclude>io/github/rawwise/axiom/pipeline/ingestion/**</testExclude>
                        <testExclude>io/github/rawwise/axiom/pipeline/feedback/FeedbackPathE2ETest.java</testExclude>
                        <testExclude>io/github/rawwise/axiom/pipeline/feedback/LoopConvergenceRealStorageE2ETest.java</testExclude>
                        <testExclude>io/github/rawwise/backend/flink/RawWiseFlinkSinkTest.java</testExclude>
                        <testExclude>io/github/rawwise/backend/read/**</testExclude>
                        <testExclude>io/github/rawwise/backend/routing/**</testExclude>
                        <testExclude>io/github/rawwise/backend/wal/**</testExclude>
                        <testExclude>io/github/rawwise/e2e/FrontendBackendE2ETest.java</testExclude>
                        <testExclude>**/RecoveryManagerTest.java</testExclude>
                        <testExclude>**/MetastorePitfallsTest.java</testExclude>
                        <testExclude>**/FastPathUpdateDeleteE2ETest.java</testExclude>
                        <testExclude>**/JobConcurrentRaceE2ETest.java</testExclude>
                        <testExclude>**/LoadScoreE2ETest.java</testExclude>
                        <testExclude>**/MetastoreCatalogDDLTest.java</testExclude>
                        <testExclude>**/ExecutionE2ETest.java</testExclude>
                        <testExclude>**/SparkIRAdaptorWriteTest.java</testExclude>
                        <testExclude>**/RouteDeciderTest.java</testExclude>
                        <testExclude>**/RoutingTableTest.java</testExclude>
                        <testExclude>**/AdminEndpointPermissionTest.java</testExclude>
                        <testExclude>**/ProvenanceTest.java</testExclude>
                        <testExclude>**/RbacE2ETest.java</testExclude>
                        <testExclude>**/ConfigConstraintsTest.java</testExclude>
                        <testExclude>**/TrustE2ETest.java</testExclude>
                        <testExclude>**/MetastoreRegistryTest.java</testExclude>
                        <testExclude>**/MetastoreBackupManagerTest.java</testExclude>
                        <testExclude>**/KVTableApiE2ETest.java</testExclude>
                        <testExclude>**/DynamicMmapStoreTest.java</testExclude>
                        <testExclude>**/LmdbInstanceUsageRatioTest.java</testExclude>
                        <testExclude>**/WriteBenchmarkTest.java</testExclude>
                        <testExclude>**/AxiomServiceAuthTest.java</testExclude>
                        <testExclude>**/SchemaValidatorTest.java</testExclude>
                        <testExclude>**/IndexConstraintE2ETest.java</testExclude>
                        <testExclude>**/RowGroupIndexReadE2ETest.java</testExclude>
                        <testExclude>**/RowGroupIndexAndPKIndexE2ETest.java</testExclude>
                        <testExclude>**/SchemaAwareParquetE2ETest.java</testExclude>
                        <testExclude>**/SchemaAwareParquetReadTest.java</testExclude>
                        <testExclude>**/ColumnGroupBodyCodecE2ETest.java</testExclude>
                        <testExclude>**/FaultInjectionTest.java</testExclude>
                        <testExclude>**/LmdbReadonlyStateTransitionTest.java</testExclude>
                        <testExclude>**/LmdbSpaceMonitorAlertTest.java</testExclude>
                        <testExclude>**/MemoryBudgetBaselineTest.java</testExclude>
                        <testExclude>**/ReadWriteConcurrencyTest.java</testExclude>
                        <testExclude>**/WritePathExecutorAsyncTest.java</testExclude>
                        <testExclude>**/WriteReadIntegrationTest.java</testExclude>
                        <testExclude>**/WriteThroughEndToEndTest.java</testExclude>
                        <testExclude>**/PredicateConflictDetectorTest.java</testExclude>
                        <testExclude>**/RangeReadIsolationTest.java</testExclude>
                        <testExclude>**/PKIndexCoverageE2ETest.java</testExclude>
                        <testExclude>**/ColumnGroupBenchmarkTest.java</testExclude>
                        <testExclude>**/DefaultFlushCoordinatorSnapshotRegisteredTest.java</testExclude>
                        <testExclude>**/SchemaAwareFlushWriteTest.java</testExclude>
                        <testExclude>**/IngestionDataSinkTest.java</testExclude>
                        <testExclude>**/LsmMergeReaderTest.java</testExclude>
                        <testExclude>**/CleanPipelineTest.java</testExclude>
                        <testExclude>**/AiNativeCleanSafetyPolicyTest.java</testExclude>
                        <testExclude>io/github/rawwise/engine/storage/**/*Test.java</testExclude>
                        <testExclude>io/github/rawwise/engine/clean/**</testExclude>
                        <testExclude>io/github/rawwise/engine/compaction/**</testExclude>
                                            <testExclude>**/CodecBenchmark.java</testExclude>
                        <testExclude>**/DistributedVectorSearchTest.java</testExclude>
                        <testExclude>**/VectorIngestRoutingTest.java</testExclude>
                        <testExclude>**/WalPersistenceE2ETest.java</testExclude>
                    </testExcludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <forkCount>1</forkCount>
                    <reuseForks>false</reuseForks>
                    <useModulePath>false</useModulePath>
                    <shutdown>kill</shutdown>
                    <forkedProcessExitTimeoutInSeconds>30</forkedProcessExitTimeoutInSeconds>
                    <argLine>--add-opens=java.base/java.nio=ALL-UNNAMED --add-exports=java.base/sun.nio.ch=ALL-UNNAMED --add-opens=java.base/java.lang.invoke=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/sun.security.action=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED</argLine>
                    <excludes>
                        <exclude>io/github/rawwise/axiom/orchestrator/**</exclude>
                        <exclude>io/github/rawwise/axiom/memory/**</exclude>
                        <exclude>io/github/rawwise/axiom/pipeline/MultiAgentConcurrencyTest.java</exclude>
                        <exclude>io/github/rawwise/axiom/pipeline/cognition/**</exclude>
                        <!-- See above note for derivation testExclude reasoning -->
                        <exclude>io/github/rawwise/axiom/pipeline/derivation/**</exclude>
                        <exclude>io/github/rawwise/axiom/pipeline/evaluation/**</exclude>
                        <exclude>io/github/rawwise/axiom/pipeline/ingestion/**</exclude>
                        <exclude>io/github/rawwise/axiom/pipeline/feedback/FeedbackPathE2ETest.java</exclude>
                        <exclude>io/github/rawwise/axiom/pipeline/feedback/LoopConvergenceRealStorageE2ETest.java</exclude>
                        <exclude>io/github/rawwise/backend/flink/RawWiseFlinkSinkTest.java</exclude>
                        <exclude>io/github/rawwise/backend/read/**</exclude>
                        <exclude>io/github/rawwise/backend/routing/**</exclude>
                        <exclude>io/github/rawwise/backend/wal/**</exclude>
                        <exclude>io/github/rawwise/e2e/FrontendBackendE2ETest.java</exclude>
                    </excludes>
                    <systemPropertyVariables>
                        <spark.ui.enabled>false</spark.ui.enabled>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>1.7.1</version>
                <executions>
                    <execution>
                        <phase>initialize</phase>
                        <goals>
                            <goal>detect</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>0.6.1</version>
                <configuration>
                    <protoSourceRoot>${project.basedir}/src/main/resources/protobuf</protoSourceRoot>
                    <clearOutputDirectory>false</clearOutputDirectory>
                    <protocArtifact>
                        com.google.protobuf:protoc:${protoc.version}:exe:${os.detected.classifier}
                    </protocArtifact>
                    <pluginId>grpc-java</pluginId>
                    <pluginArtifact>
                        io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}
                    </pluginArtifact>
                    <outputDirectory>${project.build.directory}/generated-sources/protobuf/java</outputDirectory>
                    <excludes>
                        <exclude>google/protobuf/*.proto</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>compile</goal>
                            <goal>compile-custom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/protobuf/java</source>
                                <source>${project.build.directory}/generated-sources/protobuf/grpc-java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- 合并依赖的 Apache-2.0 LICENSE / NOTICE，满足分发时的署名与许可保留要求 -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.rawwise.backend.server.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
