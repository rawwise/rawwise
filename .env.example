# RawWise .env Example
# Copy to .env and fill in your values: cp .env.example .env
# All settings are optional - RawWise runs out-of-the-box with NoOp defaults.

# === Embedding Provider (for AI-Native vector search) ===
# Type: noop (default, no real embeddings), http, stub, or onnx
RAWWISE_EMBEDDING_TYPE=noop
# RAWWISE_EMBEDDING_ENDPOINT=https://api.openai.com/v1
# RAWWISE_EMBEDDING_MODEL=text-embedding-3-small
# RAWWISE_EMBEDDING_API_KEY=your-api-key-here
RAWWISE_EMBEDDING_DIMENSION=1024
RAWWISE_EMBEDDING_TIMEOUT_MS=30000
RAWWISE_EMBEDDING_MAX_RETRIES=3
RAWWISE_EMBEDDING_BATCH_SIZE=32
# Format: openai_standard or openai_bge
RAWWISE_EMBEDDING_FORMAT=openai_standard

# === Summarization Provider (for L0 fact extraction) ===
RAWWISE_SUMMARIZATION_TYPE=noop
# RAWWISE_SUMMARIZATION_ENDPOINT=https://api.openai.com/v1
# RAWWISE_SUMMARIZATION_MODEL=gpt-4o-mini
# RAWWISE_SUMMARIZATION_API_KEY=your-api-key-here

# === Rate Limiting ===
RAWWISE_RATE_LIMIT_PER_IP=10000
RAWWISE_RATE_LIMIT_GLOBAL=50000

# === JVM Memory (adjust based on available RAM) ===
RAWWISE_EMBEDDED_HEAP=6g
RAWWISE_MAX_DIRECT_MEMORY=2g

# === Storage ===
RAWWISE_STORAGE_LMDB_INIT_MB=256
RAWWISE_STORAGE_LMDB_MAX_MB=4096

# === LLM-Powered Features (all default disabled) ===
# Enable these after configuring an LLM endpoint for best AI-Native performance
# RAWWISE_QUERY_REFORMULATION_ENABLED=false
# RAWWISE_RERANKER_ENABLED=false
# RAWWISE_ENTITY_EXTRACTION_ENABLED=false
# RAWWISE_L0_SUMMARIZATION_ENABLED=false
# RAWWISE_FACT_EXTRACTION_ENABLED=false
# RAWWISE_FEEDBACK_LLM_ENABLED=false
# RAWWISE_CASCADE_LLM_ENABLED=false
